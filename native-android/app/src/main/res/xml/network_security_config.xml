<?xml version="1.0" encoding="utf-8"?>
<!--
     The voice pipeline VPS is reached over plain ws:// for now, so exactly
     that host is allowed cleartext. Everything else keeps the platform
     default (HTTPS only). Point the assistant at a wss:// domain and this
     entry can go.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">45.13.232.205</domain>
    </domain-config>
</network-security-config>
