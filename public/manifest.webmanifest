{
  "id": "/",
  "name": "JW Garden Services CRM",
  "short_name": "JW Garden",
  "description": "Client, visit and invoicing manager for JW Garden Services — schedule jobs, log hours and send invoices.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#FDFBF7",
  "theme_color": "#3B5A2E",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
